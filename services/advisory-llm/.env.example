# advisory-llm (port 8004) — copy to .env or export before running uvicorn.

# mock = contract-shaped canned answers, no API key or corpus needed (default).
# rag  = BM25 retrieval over corpus/chunks.jsonl + a grounded Claude answer.
ADVISORY_MODE=mock

# Credentials for rag mode. The SDK also picks up an `ant auth login` profile,
# so this can stay unset if you've logged in that way.
# ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-opus-5

# Retrieval and conversation tuning.
ADVISORY_TOP_K=6
ADVISORY_MAX_HISTORY_TURNS=8
# ADVISORY_CORPUS_DIR=./corpus

# Leave unset to have Claude answer directly in the user's language.
# Setting it routes answers through the Bhashini translator, which is still a stub.
# BHASHINI_API_KEY=
